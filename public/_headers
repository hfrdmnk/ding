# Hashed build output never changes. Everything else (HTML, sw.js, the
# manifest, icons) keeps Cloudflare's default "max-age=0, must-revalidate",
# so new deploys reach users.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Each page sets the rest of its policy in a <meta> tag (see vite.config.ts);
# these directives only work as a header.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
